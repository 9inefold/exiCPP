#pragma once

#define EXI_VERSION_MAJOR @EXI_VERSION_MAJOR@
#define EXI_VERSION_MINOR @EXI_VERSION_MINOR@
#define EXI_VERSION_PATCH @EXI_VERSION_PATCH@
#define EXI_BUILD_TYPE    @CMAKE_BUILD_TYPE@

#define EXI_VERSION_STRING "@EXI_VERSION@"
#define EXI_BUILD_STRING   "@CMAKE_BUILD_TYPE@"

#cmakedefine01 EXI_EXCEPTIONS
#cmakedefine01 EXI_USE_THREADS
#cmakedefine01 EXI_USE_MIMALLOC

#cmakedefine01 EXI_DEBUG
#cmakedefine01 EXI_INVARIANTS
#cmakedefine01 EXI_DEV_ONLY
#cmakedefine01 EXI_LOGGING
#cmakedefine EXI_MIN_LOG_LEVEL

#cmakedefine01 EXI_ENABLE_DUMP
#cmakedefine01 EXI_ENABLE_NODISCARD

#cmakedefine01 EXI_FAST_DEBUG
#cmakedefine01 EXI_ENABLE_UNSTABLE_FEATURES
#cmakedefine01 EXI_ENABLE_EXPENSIVE_CHECKS
#cmakedefine01 EXI_OPTIMIZE_UNREACHABLE
#cmakedefine01 EXI_ENABLE_STACKTRACES
#cmakedefine01 EXI_CPPTRACE_DEMANGLE_WITH_NOTHING

#cmakedefine01 EXI_ON_WIN32
#cmakedefine01 EXI_ON_UNIX

#define EXI_ANSI 1

#define EXI_LLNONE    0
#define EXI_LLERROR   1
#define EXI_LLWARN    2
#define EXI_LLINFO    3
#define EXI_LLEXTRA   4
#define EXI_LLQUIET   EXI_LLNONE
#define EXI_LLVERBOSE EXI_LLEXTRA

#ifndef EXI_MIN_LOG_LEVEL
# if EXI_DEBUG
#  define EXI_MIN_LOG_LEVEL VERBOSE
#  define EXI_MIN_LOG_LEVEL_VAL EXI_LLVERBOSE
# else
#  define EXI_MIN_LOG_LEVEL INFO
#  define EXI_MIN_LOG_LEVEL_VAL EXI_LLINFO
# endif
#else
// Defined when EXI_MIN_LOG_LEVEL is defined in the cmake
# define EXI_MIN_LOG_LEVEL_VAL EXI_LL@EXI_MIN_LOG_LEVEL@
#endif

#if EXI_ENABLE_EXPENSIVE_CHECKS
# define EXPENSIVE_CHECKS
#endif

/// TODO: Remove this...
#define EXI_STRICT_NODISCARD EXI_ENABLE_NODISCARD

#ifdef __clang__
# pragma clang final(EXI_EXCEPTIONS)
# pragma clang final(EXI_USE_THREADS)
# pragma clang final(EXI_USE_MIMALLOC)
# pragma clang final(EXI_DEBUG)
# pragma clang final(EXI_INVARIANTS)
# pragma clang final(EXI_FAST_DEBUG)
# pragma clang final(EXI_ENABLE_UNSTABLE_FEATURES)
# pragma clang final(EXI_ENABLE_EXPENSIVE_CHECKS)
# pragma clang final(EXI_OPTIMIZE_UNREACHABLE)
# pragma clang final(EXI_ENABLE_STACKTRACES)
# pragma clang final(EXI_MIN_LOG_LEVEL)
# pragma clang final(EXI_MIN_LOG_LEVEL_VAL)
#endif
