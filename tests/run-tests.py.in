EXI_VERSION = "@EXI_VERSION@"
BUILD_MODE  = "@CMAKE_BUILD_TYPE@"

EXI_BASE_FOLDER = normpath("@EXI_BASE_FOLDER@")
EXI_TEST_FOLDER = join(EXI_BASE_FOLDER, "tests", "s")
EXI_BIN_FOLDER  = normpath("@CMAKE_LIBRARY_OUTPUT_DIRECTORY@")

EXI_EXECUTABLE  = normpath(f'{EXI_BIN_FOLDER}/exi-test-driver.exe')
XML_EXECUTABLE  = normpath(f'{EXI_BIN_FOLDER}/xml-test-driver.exe')
JAVA_EXECUTABLE = normpath("@Java_JAVA_EXECUTABLE@")
EXIFICIENT_JAR  = normpath("@EXIFICIENT_JAR@")

cwd = os.getcwd()

parser = argparse.ArgumentParser()
parser.add_argument('-q', '--quiet', action='store_true', help='silence output')
parser.add_argument('--color', action='store_true', help='print with color')
args = parser.parse_args()
QUIET = args.quiet
COLOR = '' if args.color else '-T'

def lprint(*args, **kwargs):
  if not QUIET:
    print(*args)

PRESERVE_OPTS = ['', 'cdi']
ALIGN_OPTS = ['i', 'y']
FOLDER_NAMES = ['xd', 'xe', 'id', 'ie']

def exificient_parse_opts(preserve: str, align: str) -> list[str]:
  mapping = {
    #'p': '-preservePrefixes',
    'c': '-preserveComments',
    'd': '-preserveDTDs',
    'i': '-preservePIs'
  }
  out = ['-noSchema', '-preservePrefixes', '-retainEntityReference']
  for p in preserve:
    if p in mapping:
      out.append(mapping[p])
  if align == 'y':
    out.append('-bytePacked')
  return out

def gen_subfolder_mappings() -> dict[str, tuple[str, str]]:
  out = {}
  for p in PRESERVE_OPTS:
    for a in ALIGN_OPTS:
      out[f'O{a}P{p}p'] = (p, a)
  return out

# Maps mangled name to (preserve, align)
subfolders = gen_subfolder_mappings()

# Generates all the required folders so we don't run into issues later
def make_folders(root_name):
  root = join(EXI_BASE_FOLDER, "tests", root_name)
  for folder in ['xx', 'ii']:
    f = join(root, folder)
    if not os.path.exists(f):
      os.makedirs(f)
  for subfolder in subfolders:
    for folder in FOLDER_NAMES:
      f = join(root, folder, subfolder)
      if not os.path.exists(f):
        os.makedirs(f)

################################################################################

def run_process(args):
  return run_proc(args, cwd=cwd, capture_output=True, text=True)

# Directly runs exificient
def run_exificient(args) -> bool:
  proc = run_process(f"{JAVA_EXECUTABLE} -jar {EXIFICIENT_JAR} {args}")
  if proc.returncode != 0:
    return proc.returncode
  elif proc.stderr.startswith("[Fatal Error]"):
    print(proc.stderr, flush=True)
    return 1
  elif proc.stdout.startswith("[ERROR]"):
    print(proc.stdout, flush=True)
    return 1
  return 0

# Runs exi-test-driver
def run_exi(name, args) -> bool:
  proc = run_process(f"{EXI_EXECUTABLE} {args} {COLOR}")
  if proc.returncode != 0:
    print(name, ':')
    print(proc.stderr, flush=True)
    pass
  return proc.returncode

# Runs xml-test-driver
def run_xml(name, args) -> bool:
  proc = run_process(f"{EXI_EXECUTABLE} {args} {COLOR}")
  return proc.returncode

################################################################################

def get_test_folder(folder, subfolder):
  return join(EXI_BASE_FOLDER, 'tests', 'o', 'ie', subfolder)

# xml -> exi -> xml
def exificient_identity(subfolder: str, opts: tuple[str, str], files):
  preserve, align = opts
  args = ' '.join(exificient_parse_opts(preserve, align))

  encode_folder = get_test_folder('xe', subfolder)
  decode_folder = get_test_folder('xx', subfolder)

  for filename, name in files.items():
    print(name, ':')
    exi = join(encode_folder, name + '.exi')
    xml = join(decode_folder, name + '.xml')
    if run_exificient(f'-encode {args} -i {filename} -o {exi}') == 0:
      run_exificient(f'-decode {args} -i {exi} -o {xml}')
  pass

# xml -> exi -> xml
def exicpp_identity(subfolder: str, opts: tuple[str, str], files):
  preserve, align = opts
  args = f'-O{preserve} -C0 -A{align}'

  encode_folder = get_test_folder('ie', subfolder)
  decode_folder = get_test_folder('ii', subfolder)

  for filename, name in files.items():
    exi = join(encode_folder, name + '.exi')
    xml = join(decode_folder, name + '.xml')
    run_exi(name, f'{filename} {exi} -X{xml} {args}')
  pass

def run_tests_with_opts(subfolder: str, opts: tuple[str, str], files):
  exificient_identity(subfolder, opts, files)
  exicpp_identity(subfolder, opts, files)
  # preserve, align = opts
  pass

