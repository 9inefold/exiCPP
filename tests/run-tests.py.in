import argparse
import sys, os, subprocess
from glob import glob
from os.path import isfile, join, normpath
from subprocess import run as run_proc

EXI_VERSION = "@EXI_VERSION@"
BUILD_MODE  = "@CMAKE_BUILD_TYPE@"

EXI_BASE_FOLDER = normpath("@EXI_BASE_FOLDER@")
EXI_TEST_FOLDER = join(EXI_BASE_FOLDER, "tests", "s")
EXI_BIN_FOLDER  = normpath("@CMAKE_LIBRARY_OUTPUT_DIRECTORY@")

JAVA_EXECUTABLE = normpath("@Java_JAVA_EXECUTABLE@")
EXIFICIENT_JAR  = normpath("@EXIFICIENT_JAR@")

cwd = os.getcwd()

parser = argparse.ArgumentParser()
parser.add_argument('-q', '--quiet', action='store_true', help='silence output')
args = parser.parse_args()
QUIET = args.quiet

def lprint(*args):
  if not QUIET:
    print("[test]", *args)

def run_process(args):
  return run_proc(args, cwd=cwd, capture_output=True, text=True, check=True)

def run_exificient(args) -> bool:
  proc = run_process(f"{JAVA_EXECUTABLE} -jar {EXIFICIENT_JAR} {args}")
  if proc.returncode != 0:
    return False
  elif proc.stdout.startswith("[ERROR]") or proc.stderr.startswith("[Fatal Error]"):
    return False
  return True

