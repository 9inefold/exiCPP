TEST_OUT_FOLDER = normpath("@TEST_OUT_FOLDER@")

EXI_BIN_FOLDER  = normpath("@CMAKE_LIBRARY_OUTPUT_DIRECTORY@")
EXI_EXECUTABLE  = joinpath(EXI_BIN_FOLDER, 'exi-test-driver.exe')
XML_EXECUTABLE  = joinpath(EXI_BIN_FOLDER, 'xml-test-driver.exe')

